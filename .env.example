#=====================================================================#
#  ClickHouse-Analytics-Agent — environment template                  #
#  Copy this file to `.env` (git-ignored) and fill in real values, or  #
#  run `make env` to auto-generate random secrets for the local-only   #
#  services (Postgres/Redis/MinIO/Langfuse/LibreChat).                 #
#  NEVER commit the resulting `.env` file.                             #
#=====================================================================#

#-----------------------------------------------------------------#
# Dataset / ingestion (Phase 3)
#-----------------------------------------------------------------#
# Which StackOverflow parquet year to replay. Laptop-friendly default.
YEAR=2020
# Row cap PER TABLE (posts/votes/comments) read from the parquet file.
# Raise this if you have the RAM/disk/patience for a bigger demo.
MAX_ROWS=200000
# How much to compress time: replayer emits rows ordered by CreationDate
# at wall-clock-time/SPEEDUP. 1000 = a simulated year plays out in ~9 hours;
# raise it further for a faster demo.
SPEEDUP=20000
TOPIC_PREFIX=so
BROKER=redpanda:9092
# Row cap for `make seed` (users/badges reference tables, loaded via s3()).
SEED_MAX_ROWS=500000

#-----------------------------------------------------------------#
# ClickHouse — our analytics database (Phase 1)
#-----------------------------------------------------------------#
CLICKHOUSE_ANALYTICS_USER=analytics
CLICKHOUSE_ANALYTICS_PASSWORD=REPLACE_ME_ANALYTICS_PASSWORD
# Read-only user the MCP server uses to query stackoverflow data.
CLICKHOUSE_MCP_READER_USER=mcp_reader
CLICKHOUSE_MCP_READER_PASSWORD=REPLACE_ME_MCP_READER_PASSWORD

#-----------------------------------------------------------------#
# Redpanda (Phase 2)
#-----------------------------------------------------------------#
REDPANDA_CONSOLE_PORT=8090

#-----------------------------------------------------------------#
# Grafana (Phase 4)
#-----------------------------------------------------------------#
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_GRAFANA_ADMIN_PASSWORD

#-----------------------------------------------------------------#
# Google Vertex AI / Gemini — the ONLY paid/metered component (Phase 5)
# Reference an already-rotated service account key BY PATH. Never paste
# its contents here, never commit it.
#-----------------------------------------------------------------#
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Absolute path on the HOST machine to the rotated service-account JSON.
# Mounted read-only into the LibreChat container; never baked into an image.
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/absolute/path/to/credentials.json
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-pro

#-----------------------------------------------------------------#
# ClickHouse MCP server (Phase 5)
#-----------------------------------------------------------------#
CLICKHOUSE_MCP_AUTH_TOKEN=REPLACE_ME_MCP_AUTH_TOKEN

#-----------------------------------------------------------------#
# LibreChat (Phase 5)
#-----------------------------------------------------------------#
LIBRECHAT_PORT=3080
RAG_PORT=8001
ADMIN_PANEL_PORT=3081
ADMIN_PANEL_SESSION_SECRET=REPLACE_ME_32_CHAR_MINIMUM_SECRET
MEILI_MASTER_KEY=REPLACE_ME_MEILI_MASTER_KEY
VECTORDB_DB=librechat_vectordb
VECTORDB_USER=vectordb_user
VECTORDB_PASSWORD=REPLACE_ME_VECTORDB_PASSWORD
JWT_SECRET=REPLACE_ME_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_JWT_REFRESH_SECRET
# 64-hex-char (32 byte) key + 32-hex-char (16 byte) IV, e.g.:
#   openssl rand -hex 32   /   openssl rand -hex 16
CREDS_KEY=REPLACE_ME_64_HEX_CHARS
CREDS_IV=REPLACE_ME_32_HEX_CHARS
LIBRECHAT_USER_EMAIL=you@example.com
LIBRECHAT_USER_PASSWORD=REPLACE_ME_LIBRECHAT_PASSWORD
LIBRECHAT_USER_NAME=Admin
# Unused providers — left as "user_provided" so their endpoints stay
# selectable-but-inert; nothing is charged unless a user supplies a key.
ANTHROPIC_API_KEY=user_provided
OPENAI_API_KEY=user_provided
RAG_OPENAI_API_KEY=

#-----------------------------------------------------------------#
# Langfuse — self-hosted LLM observability (Phase 5)
#-----------------------------------------------------------------#
LANGFUSE_PORT=3002
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
POSTGRES_DB=postgres
# Host port for Langfuse's Postgres (not 5432 — commonly already taken by
# other local projects; container-internal port is unaffected).
LANGFUSE_POSTGRES_PORT=5434
# Langfuse's OWN internal ClickHouse (trace storage) — separate from our
# analytics ClickHouse above; different password, different data.
LANGFUSE_CLICKHOUSE_PASSWORD=REPLACE_ME_LANGFUSE_CLICKHOUSE_PASSWORD
ENCRYPTION_KEY=REPLACE_ME_64_HEX_CHARS_OPENSSL_RAND_HEX_32
NEXTAUTH_SECRET=REPLACE_ME_NEXTAUTH_SECRET
SALT=REPLACE_ME_SALT
REDIS_AUTH=REPLACE_ME_REDIS_PASSWORD
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_PASSWORD
LANGFUSE_INIT_ORG_ID=org-local
LANGFUSE_INIT_ORG_NAME=Default Organization
LANGFUSE_INIT_PROJECT_ID=proj-local
LANGFUSE_INIT_PROJECT_NAME=ClickHouse-Analytics-Agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=REPLACE_ME_pk-lf-xxxx
LANGFUSE_INIT_PROJECT_SECRET_KEY=REPLACE_ME_sk-lf-xxxx
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_PASSWORD=REPLACE_ME_LANGFUSE_PASSWORD
LANGFUSE_INIT_USER_NAME=Admin
# LibreChat -> Langfuse trace destination (defaults to the local stack above).
LANGFUSE_PUBLIC_KEY=REPLACE_ME_pk-lf-xxxx
LANGFUSE_SECRET_KEY=REPLACE_ME_sk-lf-xxxx
LANGFUSE_BASE_URL=http://langfuse-web:3000
